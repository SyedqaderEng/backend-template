# ===========================================
# Production Environment Configuration
# ===========================================
# These values should be set as environment variables
# in your production deployment platform (Vercel, AWS, etc.)
# DO NOT commit actual values to version control

# Server Configuration
NODE_ENV=production
PORT=3000
API_VERSION=v1

# Frontend URL (for CORS) - Your production frontend domain
FRONTEND_URL=https://your-app.com

# Clerk Authentication (Production keys)
CLERK_SECRET_KEY=sk_live_xxxxxx
CLERK_PUBLISHABLE_KEY=pk_live_xxxxxx

# Supabase Database (Production instance)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1...

# Stripe Payments (Live mode keys)
STRIPE_SECRET_KEY=sk_live_xxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxx
STRIPE_PRODUCT_ID_BASIC=prod_xxxxxx
STRIPE_PRODUCT_ID_PRO=prod_xxxxxx
STRIPE_PRODUCT_ID_ENTERPRISE=prod_xxxxxx
STRIPE_PRICE_ID_BASIC=price_xxxxxx
STRIPE_PRICE_ID_PRO=price_xxxxxx
STRIPE_PRICE_ID_ENTERPRISE=price_xxxxxx

# Resend Email (Production)
RESEND_API_KEY=re_xxxxxx
EMAIL_FROM=noreply@your-app.com

# UploadThing File Storage
UPLOADTHING_SECRET=sk_live_xxxxxx
UPLOADTHING_APP_ID=xxxxxx

# Logging (Reduced verbosity for production)
LOG_LEVEL=warn
