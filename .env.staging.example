# ===========================================
# Staging Environment Configuration
# ===========================================
# Use this template for staging/testing deployments
# These should be separate from production resources

# Server Configuration
NODE_ENV=staging
PORT=3000
API_VERSION=v1

# Frontend URL (for CORS) - Your staging frontend domain
FRONTEND_URL=https://staging.your-app.com

# Clerk Authentication (Test/Development keys)
CLERK_SECRET_KEY=sk_test_xxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxx

# Supabase Database (Staging/Development instance)
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1...

# Stripe Payments (Test mode keys)
STRIPE_SECRET_KEY=sk_test_xxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxx
STRIPE_WEBHOOK_SECRET=whsec_test_xxxxxx
STRIPE_PRODUCT_ID_BASIC=prod_test_xxxxxx
STRIPE_PRODUCT_ID_PRO=prod_test_xxxxxx
STRIPE_PRODUCT_ID_ENTERPRISE=prod_test_xxxxxx
STRIPE_PRICE_ID_BASIC=price_test_xxxxxx
STRIPE_PRICE_ID_PRO=price_test_xxxxxx
STRIPE_PRICE_ID_ENTERPRISE=price_test_xxxxxx

# Resend Email (Use test domain or sandbox)
RESEND_API_KEY=re_test_xxxxxx
EMAIL_FROM=staging@your-app.com

# Logging (More verbose for debugging)
LOG_LEVEL=debug
